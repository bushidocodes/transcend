# Match CI (Node 24) and package.json engines. Fail install on older Node instead of
# shipping a broken runtime (process.loadEnvFile, util.styleText, …) — issue #144.
engine-strict=true

# aframe-gif-shader@0.9.1 declares a stale peer range (aframe@^0.9.0); the allowed
# version rule lives in package.json pnpm.peerDependencyRules. Keep peer checks on
# for everything else.
strict-peer-dependencies=true
